#include <iostream>
using namespace std;

class ArrayCalculator {
public:
    int sum(int arr[], int n) {
        int total = 0;
        for (int i = 0; i < n; i++) {
            total = total + arr[i];
        }
        return total;
    }

    float sum(float arr[], int n) {
        float total = 0;
        for (int i = 0; i < n; i++) {
            total = total + arr[i];
        }
        return total;
    }
};

int main() {
    ArrayCalculator calc;
   
    int n1;
    cout << "Enter the size of the integer array: ";
    cin >> n1;
   
    int intArray[n1];
    cout << "Enter " << n1 << " integers: " << endl;
    for (int i = 0; i < n1; i++) {
        cin >> intArray[i];
    }

    int n2;
    cout << "\nEnter the size of the float array: ";
    cin >> n2;
   
    float floatArray[n2];
    cout << "Enter " << n2 << " floating-point numbers: " << endl;
    for (int j = 0; j < n2; j++) {
        cin >> floatArray[j];
    }

    cout << "\nSum of integer array = " << calc.sum(intArray, n1) << endl;
    cout << "Sum of floating-point array = " << calc.sum(floatArray, n2) << endl;

    return 0;
}
