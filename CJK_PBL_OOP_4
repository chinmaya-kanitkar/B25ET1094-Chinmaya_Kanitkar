#include <iostream>
#include <cstring>
#include <string>
using namespace std;

class CustomString {
private:
    char* str;

public:
    // Constructor allocating memory dynamically
    CustomString(const char* inputStr) {
        str = new char[strlen(inputStr) + 1];
        strcpy(str, inputStr);
        cout << "\n[Constructor] String object created." << endl;
    }

    // Destructor releasing allocated memory
    ~CustomString() {
        cout << "[Destructor] Destroying String object and releasing dynamic memory." << endl;
        delete[] str;
    }

    void display() const {
        cout << "Stored Sentence: " << str << endl;
    }
};

int main() {
    string userSentence;
    cout << "Enter a sentence: ";
    getline(cin, userSentence);

    {
        // Scope block to illustrate object creation and automatic destruction
        CustomString s1(userSentence.c_str());
        s1.display();
    } // s1 goes out of scope here and destructor is called

    return 0;
}
