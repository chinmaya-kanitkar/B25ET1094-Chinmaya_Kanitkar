#include <iostream>
using namespace std;

class Complex {
private:
    double real;
    double imag;

public:
    // Parameterized Constructor
    Complex(double r = 0.0, double i = 0.0) : real(r), imag(i) {}

    // Copy Constructor
    Complex(const Complex &obj) {
        real = obj.real;
        imag = obj.imag;
        cout << "Copy constructor called!" << endl;
    }

    void display() const {
        cout << real << " + " << imag << "i" << endl;
    }
};

int main() {
    Complex c1(3.5, 4.5);
    cout << "Original Complex Number (c1): ";
    c1.display();

    // Invoking Copy Constructor
    Complex c2 = c1;
    cout << "Copied Complex Number (c2): ";
    c2.display();

    return 0;
}
